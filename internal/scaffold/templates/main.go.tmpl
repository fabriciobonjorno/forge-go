// Command {{.Name}} runs the {{.Name}} service.
//
//	{{.Name}}              serve HTTP (default)
//	{{.Name}} healthcheck  probe the running server; used by the Docker HEALTHCHECK
{{- if .DB}}
//	{{.Name}} migrate      apply database migrations ("migrate status" lists them)
//	{{.Name}} rollback     revert the latest migration
{{- end}}
package main

import (
	forge "github.com/fabriciobonjorno/forge-go"
{{- if and .DB .DB.Identity}}
	authpostgres "github.com/fabriciobonjorno/forge-go/auth/postgres"
{{- end}}
{{- if and .DB .DB.Jobs (not .DB.Identity)}}
	"github.com/fabriciobonjorno/forge-go/jobs"
{{- end}}
{{- if .DB}}
	"github.com/fabriciobonjorno/forge-go/{{.DB.Adapter}}"
{{- end}}

	"{{.Module}}/app/bootstrap"
{{- if .DB}}
	"{{.Module}}/db"
{{- end}}
)

{{if and .DB .DB.Identity -}}
func main() {
	forge.Main(
		bootstrap.Configure,
		postgres.CommandsFromSets(authpostgres.Migrations(), db.Migrations())...,
	)
}
{{- else if and .DB .DB.Jobs -}}
func main() {
	forge.Main(
		func(ctx context.Context, app *forge.App) error {
			if err := bootstrap.Configure(ctx, app); err != nil {
				return err
			}
			return bootstrap.JobsConfigure(app, db.Pool())
		},
		postgres.Commands(db.Migrations())...,
	)
}
{{- else if .DB -}}
func main() { forge.Main(bootstrap.Configure, {{.DB.Adapter}}.Commands(db.Migrations())...) }
{{- else -}}
func main() { forge.Main(bootstrap.Configure) }
{{- end}}
